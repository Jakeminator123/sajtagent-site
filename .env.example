# Sajtagents own Supabase project. The publishable key is browser-safe when
# every exposed table has correct RLS. Never put a secret/service-role key in
# NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_REF=

# Set one database connection. Prefer POSTGRES_URL for the running app and
# POSTGRES_URL_NON_POOLING for migrations. STORAGE_POSTGRES_URL variants are
# supported integration fallbacks. DATABASE_URL is a legacy fallback.
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
STORAGE_POSTGRES_URL=
STORAGE_POSTGRES_URL_NON_POOLING=
DATABASE_URL=

# Safe local pool defaults. Keep TLS verification enabled.
DB_SSL_REJECT_UNAUTHORIZED=true
POSTGRES_POOL_MAX=3
POSTGRES_POOL_IDLE_TIMEOUT_MS=5000
POSTGRES_CONNECT_TIMEOUT_MS=10000

# Server-to-server runtime join. Configure these as a pair only when the
# Sprite-owned runtime endpoint and matching signing key have been ratified.
SITEAGENT_RUNTIME_URL=
SITEAGENT_RUNTIME_SIGNING_KEY=

# Optional current-prototype integrations. Do not put OPENAI_API_KEY here.
# Vercel-hosted environments should prefer their automatically injected OIDC
# token; never copy VERCEL_OIDC_TOKEN into the cloud environment manually.
AI_GATEWAY_API_KEY=
GITHUB_TOKEN=
