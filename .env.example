# Public local application URL.
NEXT_PUBLIC_URL=http://localhost:3000

# Set one database connection. Prefer POSTGRES_URL for the running app and
# POSTGRES_URL_NON_POOLING for migrations. DATABASE_URL is a legacy fallback.
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
DATABASE_URL=

# Safe local pool defaults. Keep TLS verification enabled.
DB_SSL_REJECT_UNAUTHORIZED=true
POSTGRES_POOL_MAX=3
POSTGRES_POOL_IDLE_TIMEOUT_MS=5000
POSTGRES_CONNECT_TIMEOUT_MS=10000

# Optional current-prototype integrations. Do not put OPENAI_API_KEY here.
# Vercel-hosted environments should prefer their injected OIDC token.
AI_GATEWAY_API_KEY=
GITHUB_TOKEN=
