# Public configuration for the approved Sajtagent rollout. Node 24 env-file
# syntax works on Windows and Linux. Copy to ignored .env.rollout.local.
# Keep V2 disabled until the separate live release gates pass.
SITEAGENT_NEXT_ENABLED=false
SITEAGENT_SITE_ORIGIN=https://sajtagent-site.vercel.app
SITEAGENT_NEXT_PREVIEW_DOMAIN=preview.sajtagent.se
SITEAGENT_PUBLISHED_DOMAIN=sites.sajtagent.se
SITEAGENT_NEXT_VERCEL_TEAM_ID=team_j7KE5zKTm5rdg7zfWzOZhJ89
SITEAGENT_NEXT_VERCEL_PROJECT_ID=prj_Fig75Ev2mLddBP1BKj8ebcYkw0zz
NEXT_PUBLIC_SUPABASE_URL=https://ywoltuegeemqznbcgokg.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Exact Site project for Vercel linkage verification, NOT an app env override:
# prj_hMs2VN2gnj9YU42ZDcEv9U8fOpKf
# Gateways *.preview.sajtagent.se and *.sites.sajtagent.se route to Site.
# The protected artifact project must not receive these public gateway aliases.

# Fill only in the ignored file or existing secure deployment environment.
# Preserve the exact runtime URL/key from the authorized controller.
SITEAGENT_RUNTIME_URL=
SITEAGENT_RUNTIME_SIGNING_KEY=
SITEAGENT_NEXT_VERCEL_TOKEN=
SITEAGENT_NEXT_VERCEL_BYPASS=

# Use the actual Site app connection, not an MCP/admin substitute. If the app
# selects a different supported DB env name, use that name instead (see docs).
POSTGRES_URL=

# NEVER add SPRITES_API_TOKEN, SPRITES_TOKEN, SPRITE_TOKEN or SITEAGENT_SPRITES_TOKEN here.
# Sprite administration stays on the runtime controller, outside Site/workers.
