  "compilerOptions": {
    "incremental": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "types": [
      "node"
    ]
  },
  "include": [
    "lib/siteagent/next-preview-poll.ts",
    "lib/siteagent/server/agent-build-profile.ts",
